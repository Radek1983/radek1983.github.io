# Wylacznie wartosci PUBLICZNE, ktore moga znalezc sie w bundlu.
# Sekrety (hasla SMTP, prywatne klucze API, tokeny) NIE MOGA miec prefiksu VITE_
# i nie moga byc uzywane w kodzie frontendowym. Spec rozdz. 14.1 i 20.2.

# Sciezka bazowa builda. Dla user site GitHub Pages zawsze "/".
VITE_BASE=/

# Publiczny adres kanoniczny (decyzja D3, ADR 0010).
VITE_SITE_URL=https://www.highfive.academy

# Nazwa srodowiska. Trafia do version.json przez scripts/write-version.mjs.
VITE_ENV_NAME=local
